<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="BromoAirlines.Forms.AdminMainWindow"
        Title="Bromo Airlines - Admin" Width="1100" Height="700"
        WindowStartupLocation="CenterScreen">
  <Grid RowDefinitions="48,*" ColumnDefinitions="230,*">
    <Border Grid.Row="0" Grid.ColumnSpan="2" Background="{StaticResource Primary}" Padding="12,0">
      <StackPanel Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
        <TextBlock Text="✈" Foreground="White" FontSize="18"/>
        <TextBlock x:Name="LblTitle" Text="Dashboard" Foreground="White" FontWeight="SemiBold" VerticalAlignment="Center"/>
        <TextBlock x:Name="LblUser" Foreground="White" Opacity="0.85" VerticalAlignment="Center"/>
      </StackPanel>
    </Border>
    <Border Grid.Row="1" Grid.Column="0" Background="White" BorderBrush="#E5E7EB" BorderThickness="0,0,1,0" Padding="8">
      <Grid RowDefinitions="*,Auto">
        <StackPanel Spacing="2">
          <Button x:Name="MBandaraBtn" Content="📍 Master Bandara" Background="Transparent" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"/>
          <Button x:Name="MMaskapaiBtn" Content="✈ Master Maskapai" Background="Transparent" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"/>
          <Button x:Name="MJadwalBtn" Content="🗓 Master Jadwal" Background="Transparent" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"/>
          <Button x:Name="MPromoBtn" Content="🏷 Master Kode Promo" Background="Transparent" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"/>
          <Button x:Name="MStatusBtn" Content="🔄 Ubah Status" Background="Transparent" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"/>
        </StackPanel>
        <Button x:Name="BtnLogout" Grid.Row="1" Content="⏻ Logout" Foreground="{StaticResource Danger}" Background="Transparent" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"/>
      </Grid>
    </Border>
    <ContentControl x:Name="Host" Grid.Row="1" Grid.Column="1" Background="{StaticResource PageBg}"/>
  </Grid>
</Window>
