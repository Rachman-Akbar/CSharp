<UserControl x:CompileBindings="False" xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="BromoAirlines.Forms.Pages.UbahStatusView">
  <ScrollViewer VerticalScrollBarVisibility="Auto">
  <StackPanel Spacing="8" Margin="20">
    <TextBlock Classes="page-title" Text="Ubah Status Penerbangan"/>
    <TextBlock Classes="page-sub" Text="Status terakhir per jadwal. Kosong = Sesuai Jadwal"/>
    <DataGrid x:Name="Grid" AutoGenerateColumns="False" IsReadOnly="True" Height="280">
      <DataGrid.Columns>
        <DataGridTextColumn Header="Kode" Binding="{Binding Jadwal.KodePenerbangan}"/>
        <DataGridTextColumn Header="Maskapai" Binding="{Binding Jadwal.NamaMaskapai}"/>
        <DataGridTextColumn Header="Dari" Binding="{Binding Jadwal.NamaBerangkat}"/>
        <DataGridTextColumn Header="Ke" Binding="{Binding Jadwal.NamaTujuan}"/>
        <DataGridTextColumn Header="Status" Binding="{Binding StatusTerakhir}"/>
        <DataGridTextColumn Header="Terakhir Diubah" Binding="{Binding WaktuUbah}"/>
      </DataGrid.Columns>
    </DataGrid>
    <Grid ColumnDefinitions="130,*" RowDefinitions="Auto,Auto,Auto" RowSpacing="8" ColumnSpacing="8">
      <TextBlock Grid.Row="0" Grid.Column="0" Text="Status Baru" VerticalAlignment="Center"/>
      <ComboBox Grid.Row="0" Grid.Column="1" x:Name="InStatus" DisplayMemberBinding="{Binding Nama}"/>
      <TextBlock Grid.Row="1" Grid.Column="0" Text="Delay" VerticalAlignment="Center"/>
      <TextBox Grid.Row="1" Grid.Column="1" x:Name="InDelay" PlaceholderText="1 jam 30 menit" IsEnabled="False"/>
      <TextBlock Grid.Row="2" Grid.Column="0" Text="" />
      <TextBlock Grid.Row="2" Grid.Column="1" Classes="page-sub" Text="Isi durasi hanya jika status Delay."/>
    </Grid>
    <TextBlock x:Name="LblErr" Classes="field-err" IsVisible="False"/>
    <TextBlock x:Name="LblOk" IsVisible="False" Foreground="#15803D"/>
    <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
      <Button x:Name="BtnRefresh" Content="Refresh" Classes="btn-gray"/>
      <Button x:Name="BtnSimpan" Content="Simpan" Classes="btn-gray"/>
    </StackPanel>
  </StackPanel>
  </ScrollViewer>
</UserControl>
