<UserControl x:CompileBindings="False" xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="BromoAirlines.Forms.Pages.MasterPromoView">
  <ScrollViewer VerticalScrollBarVisibility="Auto">
  <StackPanel Spacing="8" Margin="20">
    <TextBlock Classes="page-title" Text="Master Kode Promo"/>
    <TextBlock Classes="page-sub" Text="Semua kode promo akan muncul di sini"/>
    <StackPanel Orientation="Horizontal" Spacing="8">
      <TextBox x:Name="TxtCari" PlaceholderText="Cari kode..." Width="250"/>
      <Button x:Name="BtnCari" Content="Cari" Classes="btn-gray"/>
      <Button x:Name="BtnRefresh" Content="Refresh" Classes="btn-gray"/>
    </StackPanel>
    <DataGrid x:Name="Grid" AutoGenerateColumns="False" IsReadOnly="True" Height="240">
      <DataGrid.Columns>
        <DataGridTextColumn Header="Kode" Binding="{Binding Kode}"/>
        <DataGridTextColumn Header="Diskon %" Binding="{Binding PersentaseDiskon}"/>
        <DataGridTextColumn Header="Maks Diskon" Binding="{Binding MaksimumDiskon}"/>
        <DataGridTextColumn Header="Berlaku Sampai" Binding="{Binding BerlakuSampai}"/>
        <DataGridTextColumn Header="Deskripsi" Binding="{Binding Deskripsi}" Width="*"/>
      </DataGrid.Columns>
    </DataGrid>
    <Grid ColumnDefinitions="130,*" RowDefinitions="Auto,Auto,Auto,Auto,Auto" RowSpacing="8" ColumnSpacing="8">
      <TextBlock Grid.Row="0" Grid.Column="0" Text="Kode (KAPITAL)" VerticalAlignment="Center"/>
      <TextBox Grid.Row="0" Grid.Column="1" x:Name="InKode"/>
      <TextBlock Grid.Row="1" Grid.Column="0" Text="Diskon %" VerticalAlignment="Center"/>
      <NumericUpDown Grid.Row="1" Grid.Column="1" x:Name="InPersen" Minimum="1" Value="10"/>
      <TextBlock Grid.Row="2" Grid.Column="0" Text="Maks Diskon" VerticalAlignment="Center"/>
      <NumericUpDown Grid.Row="2" Grid.Column="1" x:Name="InMaks" Minimum="1" Value="50000"/>
      <TextBlock Grid.Row="3" Grid.Column="0" Text="Berlaku Sampai" VerticalAlignment="Center"/>
      <DatePicker Grid.Row="3" Grid.Column="1" x:Name="InBerlaku"/>
      <TextBlock Grid.Row="4" Grid.Column="0" Text="Deskripsi" VerticalAlignment="Center"/>
      <TextBox Grid.Row="4" Grid.Column="1" x:Name="InDeskripsi" Height="60" AcceptsReturn="True"/>
    </Grid>
    <TextBlock x:Name="LblErr" Classes="field-err" IsVisible="False"/>
    <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
      <Button x:Name="BtnUbah" Content="Ubah" Classes="btn-gray"/>
      <Button x:Name="BtnHapus" Content="Hapus" Classes="btn-gray"/>
      <Button x:Name="BtnBatal" Content="Batal" Classes="btn-gray"/>
      <Button x:Name="BtnSimpan" Content="Simpan" Classes="btn-gray"/>
    </StackPanel>
  </StackPanel>
  </ScrollViewer>
</UserControl>
