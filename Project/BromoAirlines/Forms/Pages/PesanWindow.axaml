<Window x:CompileBindings="False" xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="BromoAirlines.Forms.Pages.PesanWindow"
        Title="Pemesanan Tiket" Width="620" Height="640"
        WindowStartupLocation="CenterOwner">
  <ScrollViewer VerticalScrollBarVisibility="Auto">
  <StackPanel Spacing="8" Margin="24">
    <TextBlock Classes="page-title" Text="Pemesanan Tiket"/>
    <TextBlock x:Name="LblDetail" TextWrapping="Wrap" Classes="page-sub"/>
    <TextBlock Text="Jumlah Penumpang"/>
    <NumericUpDown x:Name="NumPax" Minimum="1" Maximum="10" Value="1"/>
    <TextBlock Text="Data Penumpang (Titel + Nama Lengkap)"/>
    <StackPanel x:Name="PaxPanel" Spacing="6"/>
    <TextBlock Text="Kode Promo (opsional)"/>
    <StackPanel Orientation="Horizontal" Spacing="8">
      <TextBox x:Name="InPromo" Width="200"/>
      <Button x:Name="BtnCek" Content="Cek" Classes="btn-gray"/>
    </StackPanel>
    <TextBlock x:Name="LblPromo" Classes="page-sub"/>
    <TextBlock x:Name="LblTotal" FontWeight="Bold" FontSize="16"/>
    <TextBlock x:Name="LblErr" Classes="field-err" IsVisible="False"/>
    <TextBlock x:Name="LblOk" IsVisible="False" Foreground="#15803D" TextWrapping="Wrap"/>
    <Button x:Name="BtnBayar" Content="Konfirmasi Pemesanan" Classes="btn-primary" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"/>
  </StackPanel>
  </ScrollViewer>
</Window>
