<?xml version="1.0" encoding="utf-8" ?>
<configuration>
  <connectionStrings>
    <!-- Database aktif: MariaDB `bromo-airlines` (migrated, live).
         Adaptasi dari SQL Server (tidak tersedia di Linux) ke MySQL/MariaDB
         dengan pola ADO.NET yang sama: MySqlConnection/Command/Reader/Transaction
         sebagai analog SqlConnection/Command/Reader/Transaction. -->
    <add name="BromoAirlinesDb"
         connectionString="Server=localhost;Database=bromo-airlines;Uid=root;Pwd=;SslMode=None;"
         providerName="MySqlConnector" />
  </connectionStrings>
</configuration>
